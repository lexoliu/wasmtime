;   add sp, sp, t6
; block1: ; offset 0x68
;   mv a0, a1
;   lui t6, 2
;   add sp, sp, t6
;   ld ra, 8(sp)
;   ld s0, 0(sp)
;   addi sp, sp, 0x10
;   ret

;; With `vmctx` second, `a0` and `a1` are both kept, and `vmctx` is read from
;; `a1` before the target is written there.

function %vmctx_in_a1(i64, i64 vmctx) -> i64 system_v {
    sig0 = (i64, i64) preserve_all
    fn0 = colocated %stack_limit_interrupt sig0
    resumable_stack_limit = processor_local 16, 1024, fn0
    ss0 = explicit_slot 8192
block0(v0: i64, v1: i64):
    return v0
}

