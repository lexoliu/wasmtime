; block0: ; offset 0x0
;   addi sp, sp, -0x10
;   sd ra, 8(sp)
;   sd s0, 0(sp)
;   mv s0, sp
;   ld t5, 0x10(tp)
;   lui t6, 0xa
;   addi t6, t6, -0x3c0
;   sub t6, sp, t6
;   sltu t4, sp, t6
;   addi t4, t4, -1
;   and t6, t6, t4
;   bgeu t6, t5, 0x1c
;   mv t4, a1
;   mv a1, t6
;   auipc ra, 0 ; reloc_external RiscvCallPlt %stack_limit_interrupt 0
;   jalr ra
;   ld ra, 8(s0)
;   mv a1, t4
;   lui t6, 9
;   lui t3, 1
;   bgeu t3, t6, 0x14
;   sub t5, sp, t6
;   sb zero, 0(t5) ; trap: heap_oob
;   sub t6, t6, t3
;   j -0x10
;   lui t6, 0xffff6
;   addi t6, t6, 0x3c0
;   add sp, sp, t6
