;; A frame above 32 KiB: the probes follow the check.

function %above_32k(i64 vmctx, i64) -> i64 tail {
    sig0 = (i64, i64) preserve_all
    fn0 = colocated %stack_limit_interrupt sig0
    resumable_stack_limit = processor_local 16, 1024, fn0
    ss0 = explicit_slot 40000
block0(v0: i64, v1: i64):
    return v1
}

; VCode:
;   addi sp,sp,-16
;   sd ra,8(sp)
;   sd fp,0(sp)
;   mv fp,sp
;   ld t5,16(tp)
;   lui t6,10
;   addi t6,t6,-960
;   sub t6,sp,t6
;   sltu t4,sp,t6
;   addi t4,t4,-1
;   and t6,t6,t4
;   stack_limit_call t6,t5##vmctx=a0 save_a0=false save_a1=true TestCase(%stack_limit_interrupt)
;   inline_stack_probe##guard_size=4096 probe_count=9 tmp=t3
;   lui t6,-10
;   addi t6,t6,960
;   add sp,sp,t6
