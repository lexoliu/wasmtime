test compile precise-output
set enable_probestack=true
set probestack_strategy=inline
set preserve_frame_pointers=true
set enable_multi_ret_implicit_sret=true
set unwind_info=false
target riscv64

;; A frame of exactly `min_frame` bytes is not checked: the prologue is the
;; one of the same function without the declaration.

function %at_min_frame(i64 vmctx, i64) -> i64 tail {
    sig0 = (i64, i64) preserve_all
    fn0 = colocated %stack_limit_interrupt sig0
    resumable_stack_limit = processor_local 16, 1024, fn0
    ss0 = explicit_slot 1024
block0(v0: i64, v1: i64):
    return v1
}

; VCode:
;   addi sp,sp,-16
;   sd ra,8(sp)
;   sd fp,0(sp)
;   mv fp,sp
;   addi sp,sp,-1024
; block0:
;   mv a0,a1
;   addi sp,sp,1024
;   ld ra,8(sp)
;   ld fp,0(sp)
;   addi sp,sp,16
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   addi sp, sp, -0x10
;   sd ra, 8(sp)
;   sd s0, 0(sp)
;   mv s0, sp
;   addi sp, sp, -0x400
; block1: ; offset 0x14
;   mv a0, a1
;   addi sp, sp, 0x400
;   ld ra, 8(sp)
;   ld s0, 0(sp)
;   addi sp, sp, 0x10
;   ret

function %at_min_frame_plain(i64 vmctx, i64) -> i64 tail {
    ss0 = explicit_slot 1024
block0(v0: i64, v1: i64):
    return v1
}

; VCode:
;   addi sp,sp,-16
;   sd ra,8(sp)
;   sd fp,0(sp)
;   mv fp,sp
;   addi sp,sp,-1024
; block0:
;   mv a0,a1
;   addi sp,sp,1024
;   ld ra,8(sp)
;   ld fp,0(sp)
;   addi sp,sp,16
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   addi sp, sp, -0x10
;   sd ra, 8(sp)
;   sd s0, 0(sp)
;   mv s0, sp
;   addi sp, sp, -0x400
; block1: ; offset 0x14
;   mv a0, a1
;   addi sp, sp, 0x400
;   ld ra, 8(sp)
;   ld s0, 0(sp)
;   addi sp, sp, 0x10
;   ret

;; A frame above `min_frame` with the limit in the processor's local block:
;; the check follows the frame record and precedes the probes. `vmctx` is in
;; `a0` and is passed as it is; the second argument in `a1` is kept in `t4`.

function %processor_local(i64 vmctx, i64) -> i64 tail {
    sig0 = (i64, i64) preserve_all
    fn0 = colocated %stack_limit_interrupt sig0
    resumable_stack_limit = processor_local 16, 1024, fn0
    ss0 = explicit_slot 8192
block0(v0: i64, v1: i64):
    return v1
}

; VCode:
;   addi sp,sp,-16
;   sd ra,8(sp)
;   sd fp,0(sp)
;   mv fp,sp
;   ld t5,16(tp)
;   lui t6,2
;   sub t6,sp,t6
;   sltu t4,sp,t6
;   addi t4,t4,-1
;   and t6,t6,t4
;   stack_limit_call t6,t5##vmctx=a0 save_a0=false save_a1=true TestCase(%stack_limit_interrupt)
;   lui t3,-1
;   add sp,sp,t3
;   sw zero,0(sp)
;   add sp,sp,t3
;   sw zero,0(sp)
;   lui t6,2
;   add sp,sp,t6
;   lui t6,-2
;   add sp,sp,t6
; block0:
;   mv a0,a1
;   lui t6,2
;   add sp,sp,t6
;   ld ra,8(sp)
;   ld fp,0(sp)
;   addi sp,sp,16
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   addi sp, sp, -0x10
;   sd ra, 8(sp)
;   sd s0, 0(sp)
;   mv s0, sp
;   ld t5, 0x10(tp)
;   lui t6, 2
;   sub t6, sp, t6
;   sltu t4, sp, t6
;   addi t4, t4, -1
;   and t6, t6, t4
;   bgeu t6, t5, 0x1c
;   mv t4, a1
;   mv a1, t6
;   auipc ra, 0 ; reloc_external RiscvCallPlt %stack_limit_interrupt 0
;   jalr ra
;   ld ra, 8(s0)
;   mv a1, t4
;   lui t3, 0xfffff
;   add sp, sp, t3
;   sw zero, 0(sp)
;   add sp, sp, t3
;   sw zero, 0(sp)
;   lui t6, 2
;   add sp, sp, t6
;   lui t6, 0xffffe
;   add sp, sp, t6
; block1: ; offset 0x68
;   mv a0, a1
;   lui t6, 2
;   add sp, sp, t6
;   ld ra, 8(sp)
;   ld s0, 0(sp)
;   addi sp, sp, 0x10
;   ret

;; The same with the limit reached through global values, like
;; `stack_limit`: `vmctx`'s store context, then its limit word. The chain
;; ends in `t6`, so the target is computed in `t5`.

function %global_chain(i64 vmctx, i64) -> i64 tail {
    gv0 = vmctx
    gv1 = load.i64 notrap aligned readonly gv0+8
    gv2 = load.i64 notrap aligned gv1+24
    sig0 = (i64, i64) preserve_all
    fn0 = colocated %stack_limit_interrupt sig0
    resumable_stack_limit = gv2, 1024, fn0
    ss0 = explicit_slot 8192
block0(v0: i64, v1: i64):
    return v1
}

; VCode:
;   addi sp,sp,-16
;   sd ra,8(sp)
;   sd fp,0(sp)
;   mv fp,sp
;   ld t6,8(a0)
;   ld t6,24(t6)
;   lui t5,2
;   sub t5,sp,t5
;   sltu t4,sp,t5
;   addi t4,t4,-1
;   and t5,t5,t4
;   stack_limit_call t5,t6##vmctx=a0 save_a0=false save_a1=true TestCase(%stack_limit_interrupt)
;   lui t3,-1
;   add sp,sp,t3
;   sw zero,0(sp)
;   add sp,sp,t3
;   sw zero,0(sp)
;   lui t6,2
;   add sp,sp,t6
;   lui t6,-2
;   add sp,sp,t6
; block0:
;   mv a0,a1
;   lui t6,2
;   add sp,sp,t6
;   ld ra,8(sp)
;   ld fp,0(sp)
;   addi sp,sp,16
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   addi sp, sp, -0x10
;   sd ra, 8(sp)
;   sd s0, 0(sp)
;   mv s0, sp
;   ld t6, 8(a0)
;   ld t6, 0x18(t6)
;   lui t5, 2
;   sub t5, sp, t5
;   sltu t4, sp, t5
;   addi t4, t4, -1
;   and t5, t5, t4
;   bgeu t5, t6, 0x1c
;   mv t4, a1
;   mv a1, t5
;   auipc ra, 0 ; reloc_external RiscvCallPlt %stack_limit_interrupt 0
;   jalr ra
;   ld ra, 8(s0)
;   mv a1, t4
;   lui t3, 0xfffff
;   add sp, sp, t3
;   sw zero, 0(sp)
;   add sp, sp, t3
;   sw zero, 0(sp)
;   lui t6, 2
;   add sp, sp, t6
;   lui t6, 0xffffe
;   add sp, sp, t6
; block1: ; offset 0x6c
;   mv a0, a1
;   lui t6, 2
;   add sp, sp, t6
;   ld ra, 8(sp)
;   ld s0, 0(sp)
;   addi sp, sp, 0x10
;   ret

;; A frame above `min_frame` replaces the trapping `stack_limit` check: no
;; trap is left.

function %with_stack_limit_over(i64 vmctx, i64) -> i64 tail {
    gv0 = vmctx
    gv1 = load.i64 notrap aligned readonly gv0+8
    gv2 = load.i64 notrap aligned gv1+24
    stack_limit = gv2
    sig0 = (i64, i64) preserve_all
    fn0 = colocated %stack_limit_interrupt sig0
    resumable_stack_limit = processor_local 16, 1024, fn0
    ss0 = explicit_slot 8192
block0(v0: i64, v1: i64):
    return v1
}

