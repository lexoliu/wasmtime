;   mv t4, a1
;   mv a1, t6
;   auipc ra, 0 ; reloc_external RiscvCallPlt %stack_limit_interrupt 0
;   jalr ra
;   ld ra, 8(s0)
;   mv a1, t4
;   lui t3, 0xfffff
;   add sp, sp, t3
;   sw zero, 0(sp)
;   add sp, sp, t3
;   sw zero, 0(sp)
