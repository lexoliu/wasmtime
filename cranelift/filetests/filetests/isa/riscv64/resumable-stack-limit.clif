;; A frame of at most `min_frame` keeps the trapping `stack_limit` check.

function %with_stack_limit_small(i64 vmctx, i64) -> i64 tail {
    gv0 = vmctx
    gv1 = load.i64 notrap aligned readonly gv0+8
    gv2 = load.i64 notrap aligned gv1+24
    stack_limit = gv2
    sig0 = (i64, i64) preserve_all
    fn0 = colocated %stack_limit_interrupt sig0
    resumable_stack_limit = processor_local 16, 1024, fn0
    ss0 = explicit_slot 512
block0(v0: i64, v1: i64):
    return v1
}

; VCode:
;   addi sp,sp,-16
;   sd ra,8(sp)
;   sd fp,0(sp)
;   mv fp,sp
;   ld t6,8(a0)
;   ld t6,24(t6)
;   addi t6,t6,512
;   trap_if stk_ovf##(sp ult t6)
;   addi sp,sp,-512
; block0:
;   mv a0,a1
;   addi sp,sp,512
;   ld ra,8(sp)
;   ld fp,0(sp)
;   addi sp,sp,16
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   addi sp, sp, -0x10
;   sd ra, 8(sp)
;   sd s0, 0(sp)
;   mv s0, sp
;   ld t6, 8(a0)
;   ld t6, 0x18(t6)
;   addi t6, t6, 0x200
;   bgeu sp, t6, 8
;   .byte 0x00, 0x00, 0x00, 0x00 ; trap: stk_ovf
;   addi sp, sp, -0x200
; block1: ; offset 0x28
;   mv a0, a1
;   addi sp, sp, 0x200
;   ld ra, 8(sp)
;   ld s0, 0(sp)
;   addi sp, sp, 0x10
;   ret

;; `system_v` passes `vmctx` in `a0` and the second argument in `a1`: `a0` is
;; passed on as it is, and `a1` is kept in `t4`.

function %vmctx_in_a0(i64 vmctx, i64) -> i64 system_v {
    sig0 = (i64, i64) preserve_all
    fn0 = colocated %stack_limit_interrupt sig0
    resumable_stack_limit = processor_local 16, 1024, fn0
    ss0 = explicit_slot 8192
block0(v0: i64, v1: i64):
    return v1
}

