;; A `tail` function whose `return_call` passes more stack arguments than it
;; received: the clobber-save sequence rewrites the frame record from the
;; live `ra` after the check, so the check reloads it.

function %grows_stack_args(i64 vmctx, i64) -> i64 tail {
    sig0 = (i64, i64) preserve_all
    fn0 = colocated %stack_limit_interrupt sig0
    sig1 = (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) -> i64 tail
    fn1 = colocated %callee sig1
    resumable_stack_limit = processor_local 16, 1024, fn0
    ss0 = explicit_slot 8192
block0(v0: i64, v1: i64):
    return_call fn1(v0, v1, v1, v1, v1, v1, v1, v1, v1, v1, v1, v1)
}

