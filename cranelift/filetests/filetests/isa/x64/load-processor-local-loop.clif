test compile precise-output
set opt_level=speed
set unwind_info=false
target x86_64

;; Wasmtime's loop-header check: neither the processor-local limit (a load
;; that may not move) nor the stack pointer (rematerialized per block) is
;; hoisted out of the loop, so the hot path keeps no register for either and
;; the cold block reads the stack pointer itself.
function %loop_check(i64, i32) {
    fn0 = colocated %interrupt(i64, i64)

block0(v0: i64, v1: i32):
    jump block1(v1)

block1(v2: i32):
    v3 = get_stack_pointer.i64
    v4 = load_processor_local.i64 +16
    v5 = icmp ult v3, v4
    brif v5, block2, block3

block2 cold:
    call fn0(v0, v3)
    jump block3

block3:
    v6 = iconst.i32 1
    v7 = isub v2, v6
    brif v7, block1(v7), block4

block4:
    return
}

