;; A frame above 32 KiB: the frame size is an `imm32` of the `sub`, and the
;; probes follow the check.

function %above_32k(i64 vmctx, i64) -> i64 tail {
    sig0 = (i64, i64) preserve_all
    fn0 = colocated %stack_limit_interrupt sig0
    resumable_stack_limit = processor_local 16, 1024, fn0
    ss0 = explicit_slot 40000
block0(v0: i64, v1: i64):
    return v1
}

