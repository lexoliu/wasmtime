;; A frame above `min_frame` with the limit in the processor's local block:
;; the check follows the frame record and precedes the probes. `rsi` holds
;; an incoming argument, so it is saved and restored.

function %processor_local(i64 vmctx, i64) -> i64 tail {
    sig0 = (i64, i64) preserve_all
    fn0 = colocated %stack_limit_interrupt sig0
    resumable_stack_limit = processor_local 16, 1024, fn0
    ss0 = explicit_slot 8192
block0(v0: i64, v1: i64):
    return v1
}

