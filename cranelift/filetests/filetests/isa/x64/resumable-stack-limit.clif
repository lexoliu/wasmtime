test compile precise-output
set enable_probestack=true
set probestack_strategy=inline
set preserve_frame_pointers=true
set enable_multi_ret_implicit_sret=true
target x86_64

;; A frame of exactly `min_frame` bytes is not checked: the prologue is the
;; one of the same function without the declaration.

function %at_min_frame(i64 vmctx, i64) -> i64 tail {
    sig0 = (i64, i64) preserve_all
    fn0 = colocated %stack_limit_interrupt sig0
    resumable_stack_limit = processor_local 16, 1024, fn0
    ss0 = explicit_slot 1024
block0(v0: i64, v1: i64):
    return v1
}

; VCode:
;   pushq %rbp
;   movq %rsp, %rbp
;   subq $0x400, %rsp
; block0:
;   movq %rsi, %rax
;   addq $0x400, %rsp
;   movq %rbp, %rsp
;   popq %rbp
;   retq
;
; Disassembled:
; block0: ; offset 0x0
;   pushq %rbp
;   movq %rsp, %rbp
;   subq $0x400, %rsp
; block1: ; offset 0xb
;   movq %rsi, %rax
;   addq $0x400, %rsp
;   movq %rbp, %rsp
;   popq %rbp
;   retq

function %at_min_frame_plain(i64 vmctx, i64) -> i64 tail {
    ss0 = explicit_slot 1024
block0(v0: i64, v1: i64):
    return v1
}

