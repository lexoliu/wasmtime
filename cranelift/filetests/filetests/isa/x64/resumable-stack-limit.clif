;; `windows_fastcall` passes `vmctx` in `rcx` and makes `rdi` and `rsi`
;; callee-saved, and their saves come after the check: both are kept.

function %fastcall(i64 vmctx, i64) -> i64 windows_fastcall {
    sig0 = (i64, i64) preserve_all
    fn0 = colocated %stack_limit_interrupt sig0
    resumable_stack_limit = processor_local 16, 1024, fn0
    ss0 = explicit_slot 8192
block0(v0: i64, v1: i64):
    return v1
}

