;; The same with the limit reached through global values, like
;; `stack_limit`: `vmctx`'s store context, then its limit word.

function %global_chain(i64 vmctx, i64) -> i64 tail {
    gv0 = vmctx
    gv1 = load.i64 notrap aligned readonly gv0+8
    gv2 = load.i64 notrap aligned gv1+24
    sig0 = (i64, i64) preserve_all
    fn0 = colocated %stack_limit_interrupt sig0
    resumable_stack_limit = gv2, 1024, fn0
    ss0 = explicit_slot 8192
block0(v0: i64, v1: i64):
    return v1
}

