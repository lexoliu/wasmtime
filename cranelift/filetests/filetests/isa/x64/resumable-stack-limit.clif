;; Four results do not fit the return registers, so the implicit return-area
;; pointer takes `rdi` and `vmctx` moves to `rsi`: both are saved.

function %return_area(i64 vmctx) -> i64, i64, i64, i64 system_v {
    sig0 = (i64, i64) preserve_all
    fn0 = colocated %stack_limit_interrupt sig0
    resumable_stack_limit = processor_local 16, 1024, fn0
    ss0 = explicit_slot 8192
block0(v0: i64):
    return v0, v0, v0, v0
}

