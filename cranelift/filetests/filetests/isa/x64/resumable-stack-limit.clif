;; A frame of at most `min_frame` keeps the trapping `stack_limit` check.

function %with_stack_limit_small(i64 vmctx, i64) -> i64 tail {
    gv0 = vmctx
    gv1 = load.i64 notrap aligned readonly gv0+8
    gv2 = load.i64 notrap aligned gv1+24
    stack_limit = gv2
    sig0 = (i64, i64) preserve_all
    fn0 = colocated %stack_limit_interrupt sig0
    resumable_stack_limit = processor_local 16, 1024, fn0
    ss0 = explicit_slot 512
block0(v0: i64, v1: i64):
    return v1
}

