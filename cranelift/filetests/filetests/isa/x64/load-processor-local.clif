;; A store between the load and the branch is a side effect the load may not
;; move past, so the limit is read where the CLIF reads it.
function %stack_limit_check_after_store(i64) {
    fn0 = colocated %interrupt(i64)

block0(v0: i64):
    v1 = get_stack_pointer.i64
    v2 = load_processor_local.i64 +16
    store.i64 v0, v0
    v3 = icmp ult v1, v2
    brif v3, block1, block2

block1 cold:
    call fn0(v0)
    jump block2

block2:
    return
}

