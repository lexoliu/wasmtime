;; A stack-limit check against the processor's local block, as Wasmtime
;; emits it at a loop header: the loaded limit's only use is the compare.
function %stack_limit_check(i64) {
    fn0 = colocated %interrupt(i64, i64)

block0(v0: i64):
    v1 = get_stack_pointer.i64
    v2 = load_processor_local.i64 +16
    v3 = icmp ult v1, v2
    brif v3, block1, block2

block1 cold:
    call fn0(v0, v1)
    jump block2

block2:
    return
}

; VCode:
;   pushq %rbp
;   movq %rsp, %rbp
; block0:
;   movq    %rsp, %rsi
;   cmpq    %fs:16, %rsp
;   jb      label2; j label1
; block1:
;   jmp     label3
; block3:
;   movq %rbp, %rsp
;   popq %rbp
;   retq
; block2:
;   call    TestCase(%interrupt)
;   jmp     label3
;
; Disassembled:
; block0: ; offset 0x0
;   pushq %rbp
;   movq %rsp, %rbp
; block1: ; offset 0x4
;   movq %rsp, %rsi
;   cmpq %fs:0x10, %rsp
;   jb 0x1b
; block2: ; offset 0x16
;   movq %rbp, %rsp
;   popq %rbp
;   retq
; block3: ; offset 0x1b
;   callq 0x20 ; reloc_external CallPCRel4 %interrupt -4
;   jmp 0x16

;; A limit used twice cannot be folded into the compare.
function %stack_limit_check_reused(i64) -> i64 {
    fn0 = colocated %interrupt(i64, i64)

block0(v0: i64):
    v1 = get_stack_pointer.i64
    v2 = load_processor_local.i64 +16
    v3 = icmp ult v1, v2
    brif v3, block1, block2

block1 cold:
    call fn0(v0, v1)
    jump block2

block2:
    return v2
}

