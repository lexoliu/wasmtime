; block0: ; offset 0x0
;   stp x29, x30, [sp, #-0x10]!
;   mov x29, sp
;   str x19, [sp, #-0x10]!
; block1: ; offset 0xc
;   mov x1, sp
;   mrs x19, tpidr_el1
;   ldur x19, [x19, #0x10]
;   cmp x1, x19
;   b.lo #0x30
; block2: ; offset 0x20
;   mov x0, x19
; block3: ; offset 0x24
;   ldr x19, [sp], #0x10
;   ldp x29, x30, [sp], #0x10
;   ret
; block4: ; offset 0x30
;   bl #0x30 ; reloc_external Call %interrupt 0
