;   csel x16, x16, xzr, hs
;   stack_limit_call x16, x17, vmctx=x1, save_x0=true, save_x1=true, TestCase(%stack_limit_interrupt)
;   sub sp, sp, #4096
;   str wzr, [sp]
;   sub sp, sp, #4096
;   str wzr, [sp]
;   add sp, sp, #8192
;   sub sp, sp, #8192
; block0:
;   add sp, sp, #8192
;   ldp fp, lr, [sp], #16
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   stp x29, x30, [sp, #-0x10]!
;   mov x29, sp
;   mrs x17, tpidr_el1
;   ldur x17, [x17, #0x10]
;   subs x16, sp, #2, lsl #12
;   csel x16, x16, xzr, hs
;   cmp x16, x17
;   b.hs #0x40
;   mov x9, x0
;   mov x10, x1
;   mov x0, x1
;   mov x1, x16
;   bl #0x30 ; reloc_external Call %stack_limit_interrupt 0
;   ldur x30, [x29, #8]
;   mov x0, x9
;   mov x1, x10
;   sub sp, sp, #1, lsl #12
;   stur wzr, [sp]
;   sub sp, sp, #1, lsl #12
;   stur wzr, [sp]
;   add sp, sp, #2, lsl #12
;   sub sp, sp, #2, lsl #12
; block1: ; offset 0x58
;   add sp, sp, #2, lsl #12
;   ldp x29, x30, [sp], #0x10
;   ret

;; Nine results do not fit the return registers, so the implicit return-area
;; pointer takes `x8`, which the callee keeps like every register it does not
;; take an argument in.

function %return_area(i64 vmctx) -> i64, i64, i64, i64, i64, i64, i64, i64, i64 system_v {
    sig0 = (i64, i64) preserve_all
    fn0 = colocated %stack_limit_interrupt sig0
    resumable_stack_limit = processor_local 16, 1024, fn0
    ss0 = explicit_slot 8192
block0(v0: i64):
    return v0, v0, v0, v0, v0, v0, v0, v0, v0
}

