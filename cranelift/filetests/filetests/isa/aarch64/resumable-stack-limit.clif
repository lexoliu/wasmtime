test compile precise-output
set enable_probestack=true
set probestack_strategy=inline
set preserve_frame_pointers=true
set enable_multi_ret_implicit_sret=true
set unwind_info=false
target aarch64

;; A frame of exactly `min_frame` bytes is not checked: the prologue is the
;; one of the same function without the declaration.

function %at_min_frame(i64 vmctx, i64) -> i64 tail {
    sig0 = (i64, i64) preserve_all
    fn0 = colocated %stack_limit_interrupt sig0
    resumable_stack_limit = processor_local 16, 1024, fn0
    ss0 = explicit_slot 1024
block0(v0: i64, v1: i64):
    return v1
}

; VCode:
;   stp fp, lr, [sp, #-16]!
;   mov fp, sp
;   sub sp, sp, #1024
; block0:
;   mov x2, x3
;   add sp, sp, #1024
;   ldp fp, lr, [sp], #16
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   stp x29, x30, [sp, #-0x10]!
;   mov x29, sp
;   sub sp, sp, #0x400
; block1: ; offset 0xc
;   mov x2, x3
;   add sp, sp, #0x400
;   ldp x29, x30, [sp], #0x10
;   ret

function %at_min_frame_plain(i64 vmctx, i64) -> i64 tail {
    ss0 = explicit_slot 1024
block0(v0: i64, v1: i64):
    return v1
}

; VCode:
;   stp fp, lr, [sp, #-16]!
;   mov fp, sp
;   sub sp, sp, #1024
; block0:
;   mov x2, x3
;   add sp, sp, #1024
;   ldp fp, lr, [sp], #16
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   stp x29, x30, [sp, #-0x10]!
;   mov x29, sp
;   sub sp, sp, #0x400
; block1: ; offset 0xc
;   mov x2, x3
;   add sp, sp, #0x400
;   ldp x29, x30, [sp], #0x10
;   ret

;; A frame above `min_frame` with the limit in the processor's local block:
;; the check follows the frame record and precedes the probes. A `tail`
;; function takes its arguments from `x2` on, so `x0` and `x1` hold nothing
;; and nothing is saved.

function %processor_local(i64 vmctx, i64) -> i64 tail {
    sig0 = (i64, i64) preserve_all
    fn0 = colocated %stack_limit_interrupt sig0
    resumable_stack_limit = processor_local 16, 1024, fn0
    ss0 = explicit_slot 8192
block0(v0: i64, v1: i64):
    return v1
}

; VCode:
;   stp fp, lr, [sp, #-16]!
;   mov fp, sp
;   mrs x17, tpidr_el1 ; ldr x17, [x17, #16]
;   subs x16, sp, #8192
;   csel x16, x16, xzr, hs
;   stack_limit_call x16, x17, vmctx=x2, save_x0=false, save_x1=false, TestCase(%stack_limit_interrupt)
;   sub sp, sp, #4096
;   str wzr, [sp]
;   sub sp, sp, #4096
;   str wzr, [sp]
;   add sp, sp, #8192
;   sub sp, sp, #8192
; block0:
;   mov x2, x3
;   add sp, sp, #8192
;   ldp fp, lr, [sp], #16
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   stp x29, x30, [sp, #-0x10]!
;   mov x29, sp
;   mrs x17, tpidr_el1
;   ldur x17, [x17, #0x10]
;   subs x16, sp, #2, lsl #12
;   csel x16, x16, xzr, hs
;   cmp x16, x17
;   b.hs #0x30
;   mov x0, x2
;   mov x1, x16
;   bl #0x28 ; reloc_external Call %stack_limit_interrupt 0
;   ldur x30, [x29, #8]
;   sub sp, sp, #1, lsl #12
;   stur wzr, [sp]
;   sub sp, sp, #1, lsl #12
;   stur wzr, [sp]
;   add sp, sp, #2, lsl #12
;   sub sp, sp, #2, lsl #12
; block1: ; offset 0x48
;   mov x2, x3
;   add sp, sp, #2, lsl #12
;   ldp x29, x30, [sp], #0x10
;   ret

;; The same with the limit reached through global values, like
;; `stack_limit`: `vmctx`'s store context, then its limit word. The chain
;; ends in `x16`, so the target is computed in `x17`.

function %global_chain(i64 vmctx, i64) -> i64 tail {
    gv0 = vmctx
    gv1 = load.i64 notrap aligned readonly gv0+8
    gv2 = load.i64 notrap aligned gv1+24
    sig0 = (i64, i64) preserve_all
    fn0 = colocated %stack_limit_interrupt sig0
    resumable_stack_limit = gv2, 1024, fn0
    ss0 = explicit_slot 8192
block0(v0: i64, v1: i64):
    return v1
}

