;   stp fp, lr, [sp, #-16]!
;   mov fp, sp
;   ldr x16, [x2, #8]
;   ldr x16, [x16, #24]
;   subs x17, sp, #8192
;   csel x17, x17, xzr, hs
;   stack_limit_call x17, x16, vmctx=x2, save_x0=false, save_x1=false, TestCase(%stack_limit_interrupt)
;   sub sp, sp, #4096
;   str wzr, [sp]
;   sub sp, sp, #4096
;   str wzr, [sp]
;   add sp, sp, #8192
;   sub sp, sp, #8192
; block0:
;   mov x2, x3
;   add sp, sp, #8192
;   ldp fp, lr, [sp], #16
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   stp x29, x30, [sp, #-0x10]!
;   mov x29, sp
;   ldur x16, [x2, #8]
;   ldur x16, [x16, #0x18]
;   subs x17, sp, #2, lsl #12
;   csel x17, x17, xzr, hs
;   cmp x17, x16
;   b.hs #0x30
;   mov x0, x2
;   mov x1, x17
;   bl #0x28 ; reloc_external Call %stack_limit_interrupt 0
;   ldur x30, [x29, #8]
;   sub sp, sp, #1, lsl #12
;   stur wzr, [sp]
;   sub sp, sp, #1, lsl #12
;   stur wzr, [sp]
;   add sp, sp, #2, lsl #12
;   sub sp, sp, #2, lsl #12
; block1: ; offset 0x48
;   mov x2, x3
;   add sp, sp, #2, lsl #12
;   ldp x29, x30, [sp], #0x10
;   ret

;; A frame above `min_frame` replaces the trapping `stack_limit` check: no
;; trap island is left.

function %with_stack_limit_over(i64 vmctx, i64) -> i64 tail {
    gv0 = vmctx
    gv1 = load.i64 notrap aligned readonly gv0+8
    gv2 = load.i64 notrap aligned gv1+24
    stack_limit = gv2
    sig0 = (i64, i64) preserve_all
    fn0 = colocated %stack_limit_interrupt sig0
    resumable_stack_limit = processor_local 16, 1024, fn0
    ss0 = explicit_slot 8192
block0(v0: i64, v1: i64):
    return v1
}

