;; A frame of at most `min_frame` keeps the trapping `stack_limit` check.

function %with_stack_limit_small(i64 vmctx, i64) -> i64 tail {
    gv0 = vmctx
    gv1 = load.i64 notrap aligned readonly gv0+8
    gv2 = load.i64 notrap aligned gv1+24
    stack_limit = gv2
    sig0 = (i64, i64) preserve_all
    fn0 = colocated %stack_limit_interrupt sig0
    resumable_stack_limit = processor_local 16, 1024, fn0
    ss0 = explicit_slot 512
block0(v0: i64, v1: i64):
    return v1
}

; VCode:
;   stp fp, lr, [sp, #-16]!
;   mov fp, sp
;   ldr x16, [x2, #8]
;   ldr x16, [x16, #24]
;   add x16, x16, #512
;   subs xzr, sp, x16, UXTX
;   b.lo #trap=stk_ovf
;   sub sp, sp, #512
; block0:
;   mov x2, x3
;   add sp, sp, #512
;   ldp fp, lr, [sp], #16
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   stp x29, x30, [sp, #-0x10]!
;   mov x29, sp
;   ldur x16, [x2, #8]
;   ldur x16, [x16, #0x18]
;   add x16, x16, #0x200
;   cmp sp, x16
;   b.lo #0x30
;   sub sp, sp, #0x200
; block1: ; offset 0x20
;   mov x2, x3
;   add sp, sp, #0x200
;   ldp x29, x30, [sp], #0x10
;   ret
;   udf #0xc11f ; trap: stk_ovf

;; `system_v` passes `vmctx` in `x0` and the second argument in `x1`: `x0`
;; is passed on as it is, and `x1` is kept in `x10`.

function %vmctx_in_x0(i64 vmctx, i64) -> i64 system_v {
    sig0 = (i64, i64) preserve_all
    fn0 = colocated %stack_limit_interrupt sig0
    resumable_stack_limit = processor_local 16, 1024, fn0
    ss0 = explicit_slot 8192
block0(v0: i64, v1: i64):
    return v1
}

; VCode:
;   stp fp, lr, [sp, #-16]!
;   mov fp, sp
;   mrs x17, tpidr_el1 ; ldr x17, [x17, #16]
;   subs x16, sp, #8192
;   csel x16, x16, xzr, hs
;   stack_limit_call x16, x17, vmctx=x0, save_x0=false, save_x1=true, TestCase(%stack_limit_interrupt)
;   sub sp, sp, #4096
;   str wzr, [sp]
;   sub sp, sp, #4096
;   str wzr, [sp]
;   add sp, sp, #8192
;   sub sp, sp, #8192
; block0:
;   mov x0, x1
;   add sp, sp, #8192
;   ldp fp, lr, [sp], #16
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   stp x29, x30, [sp, #-0x10]!
;   mov x29, sp
;   mrs x17, tpidr_el1
;   ldur x17, [x17, #0x10]
;   subs x16, sp, #2, lsl #12
;   csel x16, x16, xzr, hs
;   cmp x16, x17
;   b.hs #0x34
;   mov x10, x1
;   mov x1, x16
;   bl #0x28 ; reloc_external Call %stack_limit_interrupt 0
;   ldur x30, [x29, #8]
;   mov x1, x10
;   sub sp, sp, #1, lsl #12
;   stur wzr, [sp]
;   sub sp, sp, #1, lsl #12
;   stur wzr, [sp]
;   add sp, sp, #2, lsl #12
;   sub sp, sp, #2, lsl #12
; block1: ; offset 0x4c
;   mov x0, x1
;   add sp, sp, #2, lsl #12
;   ldp x29, x30, [sp], #0x10
;   ret

;; With `vmctx` second, `x0` and `x1` are both kept, and `vmctx` is read from
;; `x1` before the target is written there.

function %vmctx_in_x1(i64, i64 vmctx) -> i64 system_v {
    sig0 = (i64, i64) preserve_all
    fn0 = colocated %stack_limit_interrupt sig0
    resumable_stack_limit = processor_local 16, 1024, fn0
    ss0 = explicit_slot 8192
block0(v0: i64, v1: i64):
    return v0
}

; VCode:
;   stp fp, lr, [sp, #-16]!
;   mov fp, sp
;   mrs x17, tpidr_el1 ; ldr x17, [x17, #16]
