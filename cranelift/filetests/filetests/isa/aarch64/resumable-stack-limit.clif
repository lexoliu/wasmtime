;; A frame size that is no `imm12` (neither below 4096 nor a multiple of it),
;; so the constant goes through `load_constant` into the target register.

function %not_imm12(i64 vmctx, i64) -> i64 tail {
    sig0 = (i64, i64) preserve_all
    fn0 = colocated %stack_limit_interrupt sig0
    resumable_stack_limit = processor_local 16, 1024, fn0
    ss0 = explicit_slot 5000
block0(v0: i64, v1: i64):
    return v1
}

