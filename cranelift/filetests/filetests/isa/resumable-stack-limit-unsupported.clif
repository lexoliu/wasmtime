; Only the x64, aarch64 and riscv64 backends emit the resumable stack check so
; far, so each of the others refuses a function that declares one rather than
; compiling it without the check.
test compile expect-fail
target s390x
target pulley64

function %f(i64 vmctx) tail {
    sig0 = (i64, i64) preserve_all
    fn0 = colocated %stack_limit_interrupt sig0
    resumable_stack_limit = processor_local 16, 16384, fn0
block0(v0: i64):
    return
}
