(component
  (import "item" (type $item (sub resource)))
  (import "inspect" (func $inspect async (param "item" (borrow $item))))
  (core func $sync (canon lower (func $inspect)))
  (core func $async (canon lower (func $inspect) async))
  (core func $drop (canon resource.drop $item))
  (core module $m
    (import "" "drop" (func $drop (param i32)))
    (import "" "sync" (func $sync (param i32)))
    (import "" "async" (func $async (param i32) (result i32)))
    (func (export "sync") (param i32)
      (call $sync (local.get 0))
      (call $drop (local.get 0)))
    (func (export "async") (param i32)
      (drop (call $async (local.get 0)))
      (call $drop (local.get 0))))
  (core instance $i (instantiate $m (with "" (instance
    (export "sync" (func $sync))
    (export "drop" (func $drop))
    (export "async" (func $async))))))
  (func (export "sync") async (param "item" (borrow $item))
    (canon lift (core func $i "sync")))
  (func (export "async") async (param "item" (borrow $item))
    (canon lift (core func $i "async")))
)
